# Copy to .env at repository root. Do not commit credentials.
SEC_USER_AGENT=StockIntelligenceAI contact=YOUR_EMAIL
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
# Backend alias permits secure proxy binding without reserved OPENAI_ variable names.
# Run Stock Analyser and LM Studio on the SAME Windows PC. No remote model endpoint.
# Select local / disabled / openai explicitly; local never falls back to a paid API.
AI_PROVIDER=local
LOCAL_AI_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_AI_MODEL=qwen/qwen3.5-9b
# Leave blank when LM Studio's Require Authentication option is off.
LOCAL_AI_API_KEY=
LOCAL_AI_CONTEXT_TOKENS=8192
LOCAL_AI_MAX_OUTPUT_TOKENS=1200
LOCAL_AI_TIMEOUT_SECONDS=180
LOCAL_AI_QUICK_BATCHES=6
LOCAL_AI_DEEP_BATCHES=12
# Paid AI remains independently blocked, including when a key is configured.
PAID_AI_ENABLED=false
RESEARCH_API_KEY=
RESEARCH_MODEL=gpt-6.1-sol
ADVANCED_MODEL=gpt-6-astra
# Verify the exact API model ID and prices in your account. No automatic fallback.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
RESEARCH_MAX_USD=0.25
RESEARCH_MAX_ARTICLES=30
RESEARCH_MAX_OUTPUT_TOKENS=3000
CACHE_SECONDS=3600
# Required for production. Next.js server sends this to the backend; never NEXT_PUBLIC_.
APP_TOKEN=
APP_ENVIRONMENT=development
# Optional SQLAlchemy URL, defaults to repository stock.db
# DATABASE_URL=sqlite:////workspace/Stock-Analyser/stock.db
# Next server only; optional when running backend on default port.
BACKEND_URL=http://127.0.0.1:8000
